[Unit]
Description=Herdr headless terminal server
Documentation=https://herdr.dev/docs/cli-reference/
After=default.target

[Service]
Type=simple
ExecStart=/usr/local/bin/herdr server
Restart=on-failure
RestartSec=2
Environment=PATH=/home/exedev/.local/bin:/home/exedev/.cargo/bin:/home/exedev/go/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin

[Install]
WantedBy=default.target
