[Unit]
Description=Enroll this VM as a bb execution machine
ConditionPathExists=/exe.dev/bb.env
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=exedev
Group=exedev
EnvironmentFile=/exe.dev/bb.env
ExecStart=/usr/local/bin/bb-enroll
ExecStartPost=/usr/bin/sudo /bin/rm -f /exe.dev/bb.env
Environment=HOME=/home/exedev
Environment=USER=exedev
Environment=PATH=/home/exedev/.local/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bb-enroll

[Install]
WantedBy=multi-user.target
